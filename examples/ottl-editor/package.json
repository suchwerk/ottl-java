{
  "name": "ottl-editor",
  "version": "0.1.0",
  "description": "Vue 3 / Quasar / Monaco editor for OTTL rules, backed by the OTTL language server over WebSocket.",
  "productName": "OTTL Rule Editor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "vue-tsc --noEmit && quasar build",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test src/composables/editorSessionPolicy.test.ts",
    "preview": "quasar serve dist",
    "postinstall": "quasar prepare --silent",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@codingame/monaco-vscode-editor-api": "^37.6.0",
    "@codingame/monaco-vscode-files-service-override": "^37.6.0",
    "@quasar/extras": "^2.1.0",
    "@quasar/quasar-ui-qmarkdown": "^4.2.1",
    "monaco-languageclient": "^11.0.3",
    "quasar": "^2.35.2",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@^37.6.0",
    "vscode-ws-jsonrpc": "^4.0.3",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@codingame/monaco-vscode-rollup-vsix-plugin": "^37.6.0",
    "@playwright/test": "^1.49.1",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@parcel/watcher@2.6.0": true
  }
}
